    "tryon.promptIntro": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un prompt in inglese da incollare in ChatGPT o Gemini insieme alla tua foto e alle foto dei capi: il risultato è una fotografia di te che li indossa. Gratis, nessuna chiave richiesta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate an English prompt to paste into ChatGPT or Gemini along with your photo and the garment photos: the result is a photograph of you wearing them. Free, no key required."
          }
        }
      }
    },
