    "armocromia.seasons.bright-spring.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori caldi e accesi: corallo vivo, turchese, giallo oro. Più il colore è vivo, più funziona."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, vivid colors: bright coral, turquoise, golden yellow. The brighter the color, the better it works."
          }
        }
      }
    },
    "armocromia.seasons.bright-spring.name": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Primavera Brillante"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright Spring"
          }
        }
      }
    },
    "armocromia.seasons.bright-winter.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori freddi e accesi: fucsia, blu elettrico, rosso ciliegia. Contrasti netti e tinte sature ti esaltano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool, vivid colors: fuchsia, electric blue, cherry red. Sharp contrast and saturated shades light you up."
          }
        }
      }
    },
    "armocromia.seasons.bright-winter.name": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverno Brillante"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright Winter"
          }
        }
      }
    },
    "armocromia.seasons.deep-autumn.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori caldi e profondi: vinaccia, verde pino, cioccolato. Le tinte ricche e scure incorniciano il viso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, deep colors: wine, pine green, chocolate. Rich dark shades frame your face."
          }
        }
      }
    },
    "armocromia.seasons.deep-autumn.name": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autunno Profondo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep Autumn"
          }
        }
      }
    },
    "armocromia.seasons.deep-winter.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori freddi e profondi: bordeaux, navy, smeraldo. Scuri intensi e contrasto col bianco puro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool, deep colors: burgundy, navy, emerald. Intense darks with pure white contrast."
          }
        }
      }
    },
    "armocromia.seasons.deep-winter.name": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverno Profondo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep Winter"
          }
        }
      }
    },
    "armocromia.seasons.light-spring.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori caldi, chiari e delicati: pesca, menta, crema. Ti illuminano tinte tenui e luminose, mai pesanti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, light, delicate colors: peach, mint, cream. Soft luminous shades suit you — never heavy ones."
          }
        }
      }
    },
    "armocromia.seasons.light-spring.name": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Primavera Chiara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light Spring"
          }
        }
      }
    },
    "armocromia.seasons.light-summer.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori freddi, chiari e polverosi: lavanda, rosa cipria, azzurro polvere. Meglio i toni tenui dei contrasti forti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool, light, dusty colors: lavender, powder pink, powder blue. Gentle tones beat strong contrast."
          }
        }
      }
    },
    "armocromia.seasons.light-summer.name": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estate Chiara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light Summer"
          }
        }
      }
    },
    "armocromia.seasons.soft-autumn.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori caldi e attenuati: salvia, miele, terracotta spenta. I toni fusi e polverosi valorizzano più dei colori puri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, muted colors: sage, honey, dusty terracotta. Blended dusty tones flatter more than pure brights."
          }
        }
      }
    },
    "armocromia.seasons.soft-autumn.name": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autunno Soft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft Autumn"
          }
        }
      }
    },
    "armocromia.seasons.soft-summer.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori freddi e attenuati: lilla, salvia, blu ghiaccio. Sfumature morbide, mai tinte urlate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool, muted colors: lilac, sage, ice blue. Soft shades, never loud ones."
          }
        }
      }
    },
    "armocromia.seasons.soft-summer.name": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estate Soft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft Summer"
          }
        }
      }
    },
    "armocromia.seasons.true-autumn.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori caldi e terrosi: ruggine, oliva, senape, rame. I toni delle spezie e della terra sono i tuoi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, earthy colors: rust, olive, mustard, copper. Spice and earth tones are yours."
          }
        }
      }
    },
    "armocromia.seasons.true-autumn.name": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autunno Assoluto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "True Autumn"
          }
        }
      }
    },
    "armocromia.seasons.true-spring.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori caldi e vivaci: corallo, verde erba, giallo dorato. Il calore è la tua cifra: evita il nero vicino al viso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, lively colors: coral, grass green, golden yellow. Warmth is your signature: keep black away from your face."
          }
        }
      }
    },
    "armocromia.seasons.true-spring.name": {
      "extractionState": "manual",
      "localizations": {
