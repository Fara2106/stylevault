    "armocromia.seasons.true-summer.desc": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori freddi e morbidi: malva, azzurri, prugna chiaro. L'argento e i toni polverosi ti donano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool, soft colors: mauve, blues, light plum. Silver and dusty tones flatter you."
