    "native.outfit.position.message": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per il meteo di dove sei. Usiamo una posizione approssimativa: le coordinate arrotondate vanno a Open-Meteo, il servizio delle previsioni, e non restano sul telefono. Puoi sempre scegliere una città a mano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is used for the weather where you are. We use an approximate location: rounded coordinates go to Open-Meteo, the forecast service, and are not kept on your phone. You can always pick a city by hand."
          }
        }
      }
    },
