    "native.prompt.consentText": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui prepari un testo e le foto da portare in ChatGPT (OpenAI) o in Gemini (Google). Se decidi di farlo, la tua foto e quelle dei capi vanno a quel servizio, secondo le sue regole. StyleVault non manda nulla da sola: sei tu a incollare e inviare. Usa solo foto tue o di chi ha dato il consenso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you prepare a text and photos to take to ChatGPT (OpenAI) or Gemini (Google). If you do, your photo and the item photos go to that service, under its terms. StyleVault sends nothing by itself: you paste and send them. Only use photos of yourself or of someone who agreed."
          }
        }
      }
    },
