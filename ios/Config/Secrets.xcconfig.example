// Copia in Secrets.xcconfig (non in git) e metti i valori di .env.local.
// In un xcconfig "//" apre un commento: per l'URL si spezza con $().
SUPABASE_URL = https:/$()/TUO-PROGETTO.supabase.co
SUPABASE_KEY = sb_publishable_...
// Facoltativo, solo DEBUG su iPhone vero: http:/$()/<IP del Mac>:5181/
SITE_URL =
